{
  "name": "A/B/C 失电 + 电池放电 + 恢复",
  "loop": true,
  "steps": [
    {
      "at": 0,
      "log": "初始：交流正常，电池浮充",
      "set": {
        "0x0101": {"电池电压": 53.5, "电容电压": 54.0},
        "0x0102": {
          "A 相失电告警信号": false,
          "B 相失电告警信号": false,
          "C 相失电告警信号": false,
          "活化状态信号": false,
          "电池欠压告警信号": false,
          "电池欠压切除信号": false,
          "直流绝缘告警信号": false,
          "电池容量故障告警信号": false
        },
        "0x0103": {"最大放电时间": 0, "当前放电时长": 0},
        "0x0104": {
          "A 相失电告警信号": false,
          "B 相失电告警信号": false,
          "C 相失电告警信号": false,
          "电池欠压告警信号": false,
          "电池欠压切除信号": false,
          "交流失电告警": false,
          "操作电压欠压告警信号": false,
          "后备电源运行状态": false
        }
      }
    },
    {
      "at": 3000,
      "log": "A 相失电（单相，不触发交流失电）",
      "set": {
        "0x0102": {"A 相失电告警信号": true},
        "0x0104": {"A 相失电告警信号": true}
      }
    },
    {
      "at": 6000,
      "log": "B/C 相也失电，交流失电告警，后备投入",
      "set": {
        "0x0101": {"电池电压": 52.8},
        "0x0102": {
          "B 相失电告警信号": true,
          "C 相失电告警信号": true
        },
        "0x0104": {
          "B 相失电告警信号": true,
          "C 相失电告警信号": true,
          "交流失电告警": true,
          "后备电源运行状态": true
        }
      }
    },
    {
      "at": 10000,
      "log": "电池放到 46.0V，欠压告警",
      "set": {
        "0x0101": {"电池电压": 46.0},
        "0x0102": {"电池欠压告警信号": true},
        "0x0103": {"当前放电时长": 5, "最大放电时间": 5},
        "0x0104": {
          "电池欠压告警信号": true,
          "操作电压欠压告警信号": true
        }
      }
    },
    {
      "at": 15000,
      "log": "电池放到 43.0V，欠压切除",
      "set": {
        "0x0101": {"电池电压": 43.0},
        "0x0102": {"电池欠压切除信号": true},
        "0x0104": {"电池欠压切除信号": true}
      }
    },
    {
      "at": 20000,
      "log": "交流恢复，告警复归",
      "set": {
        "0x0101": {"电池电压": 53.5},
        "0x0102": {
          "A 相失电告警信号": false,
          "B 相失电告警信号": false,
          "C 相失电告警信号": false,
          "电池欠压告警信号": false,
          "电池欠压切除信号": false
        },
        "0x0104": {
          "A 相失电告警信号": false,
          "B 相失电告警信号": false,
          "C 相失电告警信号": false,
          "电池欠压告警信号": false,
          "电池欠压切除信号": false,
          "交流失电告警": false,
          "操作电压欠压告警信号": false,
          "后备电源运行状态": false
        }
      }
    }
  ]
}